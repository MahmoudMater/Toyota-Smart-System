PORT=3000
NODE_ENV=development
LOG_LEVEL=info

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Claim window for queue notifications (ms)
CLAIM_TIMEOUT_MS=50000

# Session TTL in Redis (seconds)
SESSION_TTL_SECONDS=1800

# SAP adapter: "fake" | "http" (http reserved for later)
SAP_ADAPTER=fake
SAP_BASE_URL=

# Gate adapter: "stub" | "real" (real reserved for later)
GATE_ADAPTER=stub

# Notification adapter: "stub" | "real" (real reserved for later)
NOTIFICATION_ADAPTER=stub

# TTS adapter: "elevenlabs" | "stub"
TTS_ADAPTER=elevenlabs

# STT adapter: "elevenlabs" | "stub"
STT_ADAPTER=elevenlabs

# ElevenLabs API key (required when TTS_ADAPTER or STT_ADAPTER = elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE_ID=
# Nest HTTP TTS can use eleven_v3. Avatar-agent LiveKit TTS uses WebSockets —
# eleven_v3 returns 403 there; prefer flash/turbo for BEY.
ELEVENLABS_TTS_MODEL_ID=eleven_v3
ELEVENLABS_AVATAR_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL_ID=scribe_v2

# TTS audio cache TTL in Redis (seconds)
TTS_CACHE_TTL_SECONDS=86400

# Avatar: canvas (default local lip-sync) | bey (Beyond Presence speech-to-video)
AVATAR_ADAPTER=canvas
# LiveKit Cloud — https://cloud.livekit.io (required when AVATAR_ADAPTER=bey)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Beyond Presence — https://bey.studio/settings/api-keys
BEY_API_KEY=
# Stock Nelly avatar id
BEY_AVATAR_ID=694c83e2-8895-4a98-bd16-56332ca3f449
# Must match agentName in avatar-agent worker
LIVEKIT_AGENT_NAME=tamkeen-avatar

# CORS origins for kiosk WebView (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NLU adapter: "rules" (regex, default) | "llm" (local LLM via OpenAI-compatible API)
NLU_ADAPTER=rules
# Base URL for the LLM server (Ollama default)
NLU_BASE_URL=http://127.0.0.1:11434/v1
# Prefer 0.6b for realtime; use 1.7b only if you have GPU headroom
NLU_MODEL=qwen3:0.6b
# API key (optional, most local servers don't need one)
NLU_API_KEY=
# Fail fast to rules — keep the Socket.io path snappy
NLU_TIMEOUT_MS=2000
# Phone regions to accept (comma-separated): EG = Egyptian, SA = Saudi
PHONE_REGIONS=EG,SA

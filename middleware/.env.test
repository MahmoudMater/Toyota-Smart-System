PORT=3000
NODE_ENV=development
LOG_LEVEL=info

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Claim window for queue notifications (ms)
CLAIM_TIMEOUT_MS=50000

# Session TTL in Redis (seconds)
SESSION_TTL_SECONDS=1800

# SAP adapter: "fake" | "http" (http reserved for later)
SAP_ADAPTER=fake
SAP_BASE_URL=

# TTS/STT adapters (must be elevenlabs for real voice / STT)
TTS_ADAPTER=elevenlabs
STT_ADAPTER=elevenlabs


ELEVENLABS_API_KEY=sk_be904c7c5b33417d17134376ac40d94e4b95830226cde2e8
ELEVENLABS_TTS_VOICE_ID=2bnoa3wtrtcUW41TrSJM
ELEVENLABS_TTS_MODEL_ID=eleven_v3
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL_ID=scribe_v2
TTS_CACHE_TTL_SECONDS=86400

# CORS origins for kiosk WebView (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Avatar: canvas (default) | bey (Beyond Presence + LiveKit)
AVATAR_ADAPTER=bey
LIVEKIT_URL=wss://tamkeen-zj4qo61y.livekit.cloud
LIVEKIT_API_KEY=APIFd29NsPVdnkM
LIVEKIT_API_SECRET=3JOQ1ZYPPTaT45H2D1mTe2OeYKqAm5At7D0NMhZ3TCr
BEY_API_KEY=sk-8XTazgI_ORwDc7kuPwQHZRMW4SgwyG2i15Oce2EZJuk
BEY_AVATAR_ID=694c83e2-8895-4a98-bd16-56332ca3f449
LIVEKIT_AGENT_NAME=tamkeen-avatar


# Avatar-agent LiveKit WS TTS (eleven_v3 is HTTP-only for Nest)
ELEVENLABS_AVATAR_TTS_MODEL_ID=eleven_flash_v2_5

# Integration logs
INTEGRATION_LOG_ENABLED=true
INTEGRATION_LOG_DIR=logs
INTEGRATION_LOG_MAX_BODY_CHARS=2000
INTEGRATION_LOG_MAX_FILE_MB=10
INTEGRATION_LOG_ROTATE_KEEP=3
